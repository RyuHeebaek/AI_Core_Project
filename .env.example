# 실행 모드: true면 키 미설정·API 장애 시 Mock 데이터 사용, false면 MISSING_API_KEY 반환 (F3019)
USE_MOCK=true

# LLM (OpenAI 또는 SSAFY GMS 호환 엔드포인트)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 공공데이터포털 공용 API 키 (식약처 영양성분 DB + 한국소비자원 생필품 가격정보)
DATA_GO_KR_API_KEY=
NUTRITION_API_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo03/getFoodNtrCpntDbInq03
CONSUMER_PRICE_API_BASE_URL=https://apis.data.go.kr/B551919/ProductPriceInfoService

# 카카오 로컬 API (Kakao Developers)
KAKAO_REST_API_KEY=
KAKAO_LOCAL_API_URL=https://dapi.kakao.com/v2/local/search/keyword.json

# 실행 제어 (NF3004 재계획 상한, Worker 재시도 상한)
MAX_REPLAN=3
MAX_WORKER_RETRY=2
DB_PATH=./backend/diet_planner.db
